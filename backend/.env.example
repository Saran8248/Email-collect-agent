# Database configuration
# Default: Local PostgreSQL container managed via docker-compose
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/hr_contacts

# SQLite fallback (uncomment if running without Docker or PostgreSQL):
# DATABASE_URL=sqlite:///./hr_contacts.db

# Server settings
HOST=127.0.0.1
PORT=8000

# CORS Origins
CORS_ORIGINS=http://127.0.0.1:8080,http://localhost:8080,http://127.0.0.1:8000,http://localhost:8000,chrome-extension://*
